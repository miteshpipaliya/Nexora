# NEXORA Environment Configuration Template (.env.example)
# Copy to .env for local development. On Vercel, configure these in Project Settings -> Environment Variables.

# ==========================================
# 1. Firebase Client SDK (Public Web Config)
# ==========================================
VITE_FIREBASE_API_KEY=AIzaSy...
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789012
VITE_FIREBASE_APP_ID=1:123456789012:web:abcdef1234567890

# ==========================================
# 2. Firebase Admin SDK (Server / Vercel Only)
# ==========================================
# Either paste full Service Account JSON string:
FIREBASE_SERVICE_ACCOUNT_KEY=
# Or provide discrete service account variables:
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# ==========================================
# 3. Brevo Transactional Email Service
# ==========================================
BREVO_API_KEY=xkeysib-your-brevo-api-key-here
BREVO_SENDER_EMAIL=nexora.tech@gmail.com
BREVO_SENDER_NAME=NEXORA Student Community

# ==========================================
# 4. Backend Cryptographic Security
# ==========================================
# Minimum 32-character random string for HMAC OTP signing
OTP_HMAC_SECRET=your_32_character_hmac_signing_secret_here

# Optional Founder Elevated Password Override
ADMIN_SECURITY_PASSWORD=