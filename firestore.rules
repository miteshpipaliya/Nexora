rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Default Deny all unspecified paths
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // RBAC: Administrative access strictly requires verified Firebase custom claim (B1)
    function isAdmin() {
      return isSignedIn() && request.auth.token.admin == true;
    }

    // Protected Server-Side Internal Collections (Frontend Access Strictly Forbidden)
    match /_otp_challenges/{challengeId} {
      allow read, write: if false;
    }
    match /_reset_authorizations/{authId} {
      allow read, write: if false;
    }
    match /_admin_challenges/{docId} {
      allow read, write: if false;
    }
    match /_revoked_sessions/{docId} {
      allow read, write: if false;
    }
    match /adminSecrets/{docId} {
      allow read, write: if false;
    }
    match /otpChallenges/{docId} {
      allow read, write: if false;
    }
    match /passwordTokens/{docId} {
      allow read, write: if false;
    }
    match /admins/{adminId} {
      allow read: if isAdmin();
      allow write: if false; // Managed exclusively via backend Admin SDK
    }

    // Student Profiles (S2: strict field mutation whitelist matching application schema)
    match /users/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isAdmin();
      allow create: if isOwner(userId) && isValidId(userId);
      allow update: if (isOwner(userId) && (incoming().id == userId || incoming().id == existing().id) &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'full_name', 'college', 'branch', 'academic_year', 'enrollment_number', 
          'division', 'phone_number', 'avatar_url', 'updated_at', 'is_profile_complete', 
          'last_active', 'email_verified', 'name', 'department', 'enrollment_no', 
          'phone', 'year_of_study'
        ])) || isAdmin();
      allow delete: if isAdmin();
    }

    // Competition Events (Public Read, Admin Write)
    match /events/{eventId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // Team Members (Public Read, Admin Write)
    match /teamMembers/{memberId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // Website Content (Public Read, Admin Write)
    match /siteContent/{contentId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // Broadcast Notifications (Public/Student Read, Admin Write)
    match /notifications/{notificationId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // Site Meta & Broadcast Schedule (Public Read, Admin Write)
    match /siteMeta/{metaId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // Student Notification Read Receipts (S3: Restricted to authenticated owner)
    match /userNotificationReads/{receiptId} {
      allow read: if isSignedIn() && (
        resource == null || resource.data.user_id == request.auth.uid || isAdmin()
      );
      allow create, update: if isSignedIn() && (
        incoming().user_id == request.auth.uid &&
        receiptId.matches('^' + request.auth.uid + '_.*$')
      );
      allow delete: if isSignedIn() && (
        resource != null && resource.data.user_id == request.auth.uid
      );
    }

    // Media Upload Metadata (S7: Write restricted to admins)
    match /mediaUploads/{uploadId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // System Config (Initialized flags)
    match /systemConfig/{configId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Competition Registrations (S1: Client create denied; must go through serverless API)
    match /registrations/{registrationId} {
      allow get: if (isSignedIn() && existing().user_id == request.auth.uid) || isAdmin();
      allow list: if (isSignedIn() && resource.data.user_id == request.auth.uid) || isAdmin();
      // Client writes disabled - registrations are processed with atomic capacity checks via server backend
      allow create: if false;
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // Contact Submissions
    match /contactMessages/{messageId} {
      allow create: if isValidId(messageId);
      allow read, update, delete: if isAdmin();
    }

    // Administrative Security Audit Logs (S9: Immutable audit trail)
    match /adminAuditLogs/{logId} {
      allow read: if isAdmin();
      allow create: if isAdmin();
      allow update, delete: if false;
    }
  }
}
