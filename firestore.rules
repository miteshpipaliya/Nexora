rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // C-01: Admin identity strictly via custom claim and verified email
    function isAdmin() {
      return isSignedIn() && 
             request.auth.token.admin == true && 
             request.auth.token.email_verified == true;
    }

    // C-02: Whitelisted profile keys, immutable ID, token email match
    function isValidUserProfile(data, userId) {
      return data.keys().hasOnly([
        'id', 'email', 'full_name', 'phone', 'college', 'branch', 
        'semester', 'academic_year', 'created_at', 'updated_at', 
        'avatar_url', 'bio'
      ]) &&
      data.id == userId &&
      (!('email' in data) || data.email == request.auth.token.email);
    }

    // ========================================================
    // INTERNAL SECURITY COLLECTIONS (STRICTLY DENY-ALL TO CLIENTS)
    // Server Admin SDK accesses these directly, bypassing rules
    // ========================================================
    match /_admin_security/{docId} {
      allow read, write: if false;
    }
    match /_admin_challenges/{docId} {
      allow read, write: if false;
    }
    match /_revoked_sessions/{docId} {
      allow read, write: if false;
    }
    match /_admin_ratelimits/{docId} {
      allow read, write: if false;
    }
    match /_otp_challenges/{challengeId} {
      allow read, write: if false;
    }
    match /_reset_authorizations/{authId} {
      allow read, write: if false;
    }
    match /adminSecrets/{docId} {
      allow read, write: if false;
    }
    match /otpChallenges/{docId} {
      allow read, write: if false;
    }
    match /passwordTokens/{docId} {
      allow read, write: if false;
    }
    match /admins/{adminId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Student Profiles (C-02)
    match /users/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isAdmin();
      allow create: if isOwner(userId) && isValidId(userId) && isValidUserProfile(incoming(), userId);
      allow update: if (isOwner(userId) && isValidUserProfile(incoming(), userId) && incoming().id == existing().id) || isAdmin();
      allow delete: if isAdmin();
    }

    // Real-Time Student Online/Offline Presence Sessions (Prompt 2)
    match /presenceSessions/{sessionId} {
      allow read: if isAdmin();
      allow create: if isSignedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasAll(['uid', 'startedAt', 'lastSeen', 'expireAt'])
        && request.resource.data.keys().hasOnly(['uid', 'startedAt', 'lastSeen', 'expireAt']);
      allow update: if isSignedIn()
        && resource.data.uid == request.auth.uid
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastSeen', 'expireAt']);
      allow delete: if isSignedIn() && resource.data.uid == request.auth.uid;
    }

    // Backward-compatible fallback for legacy userPresence
    match /userPresence/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow write: if isOwner(userId) || isAdmin();
    }

    // Competition Events (C-06: Published only for public, all for admin)
    match /events/{eventId} {
      allow read: if (resource != null && resource.data.status == 'Published') || isAdmin();
      allow create, update, delete: if isAdmin();
    }

    // Team Members (C-06: Enabled only for public, all for admin)
    match /teamMembers/{memberId} {
      allow read: if (resource != null && resource.data.enabled == true) || isAdmin();
      allow create, update, delete: if isAdmin();
    }

    // Website Content (Public Read, Admin Write)
    match /siteContent/{contentId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // Broadcast Notifications (C-06: Published & timed only for public)
    match /notifications/{notificationId} {
      allow read: if (
        resource != null && 
        resource.data.status == 'Published' && 
        (resource.data.display_at == null || resource.data.display_at <= request.time) && 
        (resource.data.expires_at == null || resource.data.expires_at > request.time)
      ) || isAdmin();
      allow create, update, delete: if isAdmin();
    }

    // Student Notification Read Receipts (C-04: uid_ prefix and owner only)
    match /userNotificationReads/{receiptId} {
      allow read, write: if isSignedIn() && receiptId.matches('^' + request.auth.uid + '_.+');
    }

    // Media Upload Metadata & Image Library
    match /mediaUploads/{uploadId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /imageLibrary/{imageId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // Team Config
    match /teamConfig/{configId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }
    match /teamRoles/{roleId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }
    match /academicBranches/{branchId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }
    match /teamDepartments/{deptId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }
    match /teamDivisions/{divId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // System Config
    match /systemConfig/{configId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Competition Registrations (C-03: Client read for owner, creation strictly server-side)
    match /registrations/{registrationId} {
      allow get: if (isSignedIn() && existing().user_id == request.auth.uid) || isAdmin();
      allow list: if (isSignedIn() && resource.data.user_id == request.auth.uid) || isAdmin();
      allow write: if false; // Creation and mutation handled exclusively by server API in transaction
    }

    // Contact Submissions (C-05: Server API endpoint handles rate limiting and creation)
    match /contactMessages/{messageId} {
      allow read, update, delete: if isAdmin();
      allow create: if false; // Route through rate-limited server endpoint
    }

    // Administrative Security Audit Logs
    match /adminAuditLogs/{logId} {
      allow read: if isAdmin();
      allow create: if isAdmin();
      allow update, delete: if false;
    }
  }
}
