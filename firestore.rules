rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Founder Administrator: Verified founder email or custom admin claim or /admins document
    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.admin == true ||
        request.auth.token.email == 'miteshpipaliya2202@gmail.com' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    // Protected Server-Side OTP Challenges and Reset Authorizations (Frontend Access Strictly Forbidden)
    match /_otp_challenges/{challengeId} {
      allow read, write: if false;
    }
    match /_reset_authorizations/{authId} {
      allow read, write: if false;
    }

    // Student Profiles
    match /users/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isAdmin();
      allow create: if isOwner(userId) && isValidId(userId) && incoming().id == userId;
      allow update: if (isOwner(userId) || isAdmin()) && incoming().id == existing().id;
      allow delete: if isAdmin();
    }

    // Competition Events (Public Read, Admin Write)
    match /events/{eventId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // Team Members (Public Read, Admin Write)
    match /teamMembers/{memberId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // Website Content (Public Read, Admin Write)
    match /siteContent/{contentId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // Competition Registrations
    match /registrations/{registrationId} {
      allow get: if (isSignedIn() && existing().user_id == request.auth.uid) || isAdmin();
      allow list: if (isSignedIn() && resource.data.user_id == request.auth.uid) || isAdmin();
      allow create: if isSignedIn() && isValidId(registrationId) && incoming().user_id == request.auth.uid;
      allow update: if isAdmin();
      allow delete: if isAdmin() || (isSignedIn() && existing().user_id == request.auth.uid);
    }

    // Contact Submissions
    match /contactMessages/{messageId} {
      allow create: if isValidId(messageId);
      allow read, update, delete: if isAdmin();
    }

    // Administrative Security Audit Logs
    match /adminAuditLogs/{logId} {
      allow read: if isAdmin();
      allow create: if isAdmin();
      allow update, delete: if false;
    }

    // Admin authorization store (Managed by backend Admin SDK only)
    match /admins/{adminId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Internal Security Store (Explicitly disallow all client reads/writes)
    match /adminSecrets/{docId} {
      allow read, write: if false;
    }
    match /otpChallenges/{docId} {
      allow read, write: if false;
    }
    match /passwordTokens/{docId} {
      allow read, write: if false;
    }
  }
}
